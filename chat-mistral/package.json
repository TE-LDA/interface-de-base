{
  "name": "chat-mistral",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jeu de gestion médiéval uchronique (React) dont la chronique est narrée via l'API Mistral (SDK TypeScript officiel)",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch src/server.ts\" \"vite\"",
    "build": "tsc && tsc --noEmit -p tsconfig.client.json && vite build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
